<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- The native app talks to the owner's self-hosted backend over HTTPS on the
       LAN (https://192.168.1.11), plus the emulator loopback. The system and
       user CA stores are trusted, so a user-installed local CA (mkcert) works.
       For zero-touch installs, see src/personal/res/ (gitignored): it overlays
       a trust anchor for the bundled local CA. -->
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
      <certificates src="user" />
    </trust-anchors>
  </base-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">localhost</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">192.168.1.11</domain>
    <domain includeSubdomains="false">192.168.1.28</domain>
    <domain includeSubdomains="false">10.0.2.2</domain>
  </domain-config>
</network-security-config>