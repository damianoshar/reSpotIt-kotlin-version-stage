<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- The native app talks to the owner's self-hosted backend over HTTPS on the
       LAN (https://192.168.1.11), plus the emulator loopback. The mkcert local
       CA installed on the device is trusted via <certificates src="user"/>. -->
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
      <certificates src="system" />
      <certificates src="user" />
    </trust-anchors>
  </base-config>
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">localhost</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">192.168.1.28</domain>
    <domain includeSubdomains="false">10.0.2.2</domain>
  </domain-config>
</network-security-config>