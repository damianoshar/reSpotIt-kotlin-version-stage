<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <!-- The native app talks to the owner's self-hosted backend over plain HTTP
       on the LAN (e.g. http://192.168.1.28:8000), plus the emulator loopback.
       Cleartext is allowed only for those hosts. -->
  <domain-config cleartextTrafficPermitted="true">
    <domain includeSubdomains="true">localhost</domain>
    <domain includeSubdomains="false">127.0.0.1</domain>
    <domain includeSubdomains="false">192.168.1.28</domain>
    <domain includeSubdomains="false">10.0.2.2</domain>
  </domain-config>
  <!-- Block all other cleartext (HTTP) traffic -->
  <base-config cleartextTrafficPermitted="false" />
</network-security-config>
